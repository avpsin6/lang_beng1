{% if not fragment %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
{% endif %}
<title>{{ title }}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
{{ css|safe }}
figure { margin: 0; }
.filters { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg);
  border-bottom: 1px solid var(--border); }
.filters .wrap { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: end; padding-block: 10px; }
.field { display: grid; gap: 3px; font-size: var(--step--1); color: var(--ink-2); min-width: 0; }
.field select, .field input {
  font: inherit; font-size: var(--step-0); color: var(--ink); background: var(--surface);
  border: 1px solid var(--axis); border-radius: 8px; padding: 6px 8px; max-width: 100%; min-height: 36px;
}
.controls { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: end; }
main { gap: 28px; }
.span { grid-column: 1 / -1; }
button.sort { color: var(--ink-2); font-weight: 600; padding: 0; }
table.data th button.sort { font-size: inherit; }
</style>
{% if not fragment %}</head>
<body>
{% endif %}
<header class="masthead">
  <div class="wrap">
    <p class="eyebrow">HealthLens · explore your data</p>
    <h1>Dashboard</h1>
    <p class="lede">Pick dates and a measure; everything below follows. Data covers {{ period }}.</p>
    <div class="masthead-row">
      <span class="chip"><span class="dot" aria-hidden="true"></span>Works offline · no data leaves this file</span>
      <span class="chip">Generated {{ generated }}</span>
      <button class="text" id="theme-toggle" type="button">Theme: system</button>
    </div>
    {% if demo %}
    <p class="demo-banner"><strong>Demo dashboard.</strong> These numbers come from a synthetic person generated by HealthLens, not from anyone's real health data.</p>
    {% endif %}
  </div>
</header>

<div class="filters" role="group" aria-label="Filters">
  <div class="wrap">
    <label class="field" for="range-preset">Dates
      <select id="range-preset">
        <option value="30">Last 30 days</option>
        <option value="90">Last 90 days</option>
        <option value="365">Last 12 months</option>
        <option value="730">Last 2 years</option>
        <option value="all">All time</option>
      </select>
    </label>
    <label class="field" for="date-from">From <input type="date" id="date-from"></label>
    <label class="field" for="date-to">To <input type="date" id="date-to"></label>
    <label class="field" for="metric-a">Measure <select id="metric-a"></select></label>
    <label class="field" for="group">Group by
      <select id="group">
        <option value="auto">Automatic</option>
        <option value="day">Day</option>
        <option value="week">Week</option>
        <option value="month">Month</option>
        <option value="year">Year</option>
      </select>
    </label>
  </div>
</div>

<main class="wrap">
  <section aria-labelledby="h-range">
    <div class="section-head"><h2 id="h-range">At a glance</h2><p id="range-note"></p></div>
    <div class="tiles" id="tiles"></div>
  </section>

  <section aria-label="Charts">
    <div class="charts">
      <figure class="card span">
        <div class="card-head">
          <div><h3>Over time</h3><p id="explorer-sub"></p></div>
          <button class="text" type="button" id="explorer-table-btn" aria-expanded="false" aria-controls="explorer-table">Show table</button>
        </div>
        <div class="plot" id="explorer-plot" role="img" aria-label="Selected measure over time"></div>
        <p class="note" id="explorer-stats"></p>
        <p class="note" id="explorer-desc"></p>
        <div id="explorer-table" hidden></div>
      </figure>

      <figure class="card span">
        <div class="card-head"><div><h3>Calendar</h3><p id="calendar-sub"></p></div></div>
        <div class="plot" id="calendar-plot" role="img" aria-label="Calendar heatmap of the selected measure"></div>
      </figure>

      <figure class="card">
        <div class="card-head"><div><h3>Compare two measures</h3><p>Each has its own scale, stacked on shared dates</p></div></div>
        <div class="controls">
          <label class="field" for="metric-b">Second measure <select id="metric-b"></select></label>
          <label class="field" for="lag">Pair each day with
            <select id="lag">
              <option value="0">the same day</option>
              <option value="1">the next day</option>
              <option value="2">two days later</option>
              <option value="7">a week later</option>
            </select>
          </label>
        </div>
        <div class="plot" id="compare-plot" role="img" aria-label="Two measures over time"></div>
      </figure>
      <figure class="card">
        <div class="card-head"><div><h3>Do they move together?</h3><p>Each dot is one day</p></div></div>
        <div class="plot" id="scatter-plot" role="img" aria-label="Scatter of the two measures"></div>
        <p class="note" id="compare-note"></p>
      </figure>

      <figure class="card span" id="sleep-card">
        <div class="card-head"><div><h3>Sleep log</h3><p id="sleep-sub"></p></div></div>
        <div class="plot" id="sleep-plot" role="img" aria-label="Bedtime to wake-up for each night"></div>
        <p class="note">Nights are dated by the morning. iPhone “time in bed” is a schedule-based estimate, not measured sleep.</p>
      </figure>

      <figure class="card span" id="workouts-card">
        <div class="card-head">
          <div><h3>Workouts</h3><p id="workouts-sub"></p></div>
          <label class="field" for="workout-type">Type <select id="workout-type"></select></label>
        </div>
        <div class="table-scroll" style="max-height: 420px; overflow-y: auto"><table class="data" id="workouts-table"></table></div>
        <p class="note" id="workouts-more"></p>
      </figure>

      <figure class="card span">
        <div class="card-head"><div><h3>This period against the one before</h3><p id="periods-sub"></p></div></div>
        <div class="table-scroll"><table class="data" id="periods-table"></table></div>
      </figure>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p><strong>Not medical advice.</strong> HealthLens shows patterns in your Apple Health data; it cannot diagnose anything. Talk to a doctor about any health concern.</p>
    <p><strong>Private by design.</strong> This file was generated on your computer and makes no network requests. It contains your health data, so share it only with people you trust.</p>
    <p>HealthLens {{ version }}</p>
  </div>
</footer>

<script type="application/json" id="hl-data">{{ data_json|safe }}</script>
<script>{{ plotly_js|safe }}</script>
<script>{{ theme_js|safe }}</script>
<script>{{ dashboard_js|safe }}</script>
{% if not fragment %}
</body>
</html>
{% endif %}
